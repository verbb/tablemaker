{
    "name": "tablemaker",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "docs"
    ],
    "scripts": {
        "dev": "vite --port 4045",
        "build": "vite build",
        "watch": "vite build --watch",
        "test:frontend": "vitest run",
        "dev:plugin-docs": "npm run docs:dev --prefix docs",
        "screenshots": "npm --prefix screenshots run screenshots --"
    },
    "devDependencies": {
        "rollup-plugin-analyzer": "^4.0.0",
        "typescript": "^5.7.3",
        "vite": "^8.0.10",
        "vite-plugin-compression": "^0.5.1",
        "vitest": "^5.0.0"
    },
    "dependencies": {
        "@verbb/plugin-kit-core": "^2.0.20",
        "@verbb/plugin-kit-icons": "^2.0.20",
        "@verbb/plugin-kit-web": "^2.0.20",
        "lodash-es": "^4.18.1"
    },
    "overrides": {
        "vitepress": {
            "vite": "6.4.3"
        }
    }
}
